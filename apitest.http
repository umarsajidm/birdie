### ==========================================
### VARIABLES (Must be at the very top)
### ==========================================
@baseUrl = http://localhost:8080
@userID = 3a9aaa94-91b0-455e-b294-e9e51ed4de20

### ==========================================
### USERS API
### ==========================================

### Create a New User (Run this to get a fresh ID)
POST {{baseUrl}}/api/users
Content-Type: application/json

{
    "email": "chirper@example.com"
}

### ==========================================
### CHIRPS API
### ==========================================

### Create a Valid Chirp
# NOTE: Replace the @userID variable at the top of this file first!
POST {{baseUrl}}/api/chirps
Content-Type: application/json

{
    "body": "This is my very first chirp!",
    "user_id": "{{userID}}"
}

### Create an Invalid Chirp - Too Long (Should return 400)
POST {{baseUrl}}/api/chirps
Content-Type: application/json

{
    "body": "This chirp is way too long. It just keeps going and going and going and going and going and going and going and going and going and going and going and going and going.",
    "user_id": "{{userID}}"
}

### Create a Chirp with Profanity (Should return 201 with ****)
POST {{baseUrl}}/api/chirps
Content-Type: application/json

{
    "body": "What a kerfuffle this sharbert is!",
    "user_id": "{{userID}}"
}

### ==========================================
### ADMIN API
### ==========================================

### Reset the Database (Dev Only)
POST {{baseUrl}}/admin/reset
Content-Type: application/json